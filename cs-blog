/*---------------------------------
 Load Editor & Media
----------------------------------*/
add_action('admin_enqueue_scripts', function ($hook) {
    if ($hook === 'toplevel_page_pro-blog-builder') {
        wp_enqueue_editor();
        wp_enqueue_media();
    }
});

/*---------------------------------
 Builder Page
----------------------------------*/
function pbb_page() {

    if (isset($_POST['pbb_submit'])) {
        pbb_save();
    }
    ?>
    <div class="wrap">
        <h1>Add New Blog</h1>

        <form method="post">
            <?php wp_nonce_field('pbb_save','pbb_nonce'); ?>

            <!-- Title -->
            <h3>Blog Title</h3>
            <input type="text" name="pbb_title" class="widefat" required>

            <!-- Category -->
            <h3>Category</h3>
            <?php wp_dropdown_categories([
                'taxonomy'=>'category',
                'name'=>'pbb_category',
                'hide_empty'=>false
            ]); ?>

            <!-- Tags -->
            <h3>Tags (comma separated)</h3>
            <input type="text" name="pbb_tags" class="widefat">

            <!-- Featured Image -->
            <h3>Featured Image</h3>
            <input type="hidden" name="pbb_featured" id="pbb_featured">
            <button type="button" class="button" id="pbb_featured_btn">Select Featured Image</button>
            <div id="pbb_featured_preview" style="margin-top:10px"></div>

            <hr>

            <!-- Content Editor -->
            <h2>Blog Content</h2>
            <?php
            wp_editor('', 'pbb_content', [
                'textarea_name' => 'pbb_content',
                'editor_height' => 400,
                'media_buttons' => true,
                'teeny' => false,
                'quicktags' => true,
            ]);
            ?>

            <br>
            <input type="submit" class="button button-primary button-large" name="pbb_submit" value="Publish Blog">
        </form>
    </div>

<script>
let frame;
document.getElementById('pbb_featured_btn').onclick = function(){
    if(frame){frame.open();return;}
    frame = wp.media({title:'Select Featured Image',multiple:false});
    frame.on('select',function(){
        let img = frame.state().get('selection').first().toJSON();
        document.getElementById('pbb_featured').value = img.id;
        document.getElementById('pbb_featured_preview').innerHTML =
            '<img src="'+img.url+'" style="max-width:200px;border:1px solid #ccc">';
    });
    frame.open();
};
</script>
<?php }

/*---------------------------------
 Save Blog
----------------------------------*/
function pbb_save() {

    if (!wp_verify_nonce($_POST['pbb_nonce'],'pbb_save')) return;

    $post_id = wp_insert_post([
        'post_title'   => sanitize_text_field($_POST['pbb_title']),
        'post_content' => wp_kses_post($_POST['pbb_content']),
        'post_status'  => 'publish',
        'post_type'    => 'post',
        'post_category'=> [intval($_POST['pbb_category'])],
        'tags_input'   => sanitize_text_field($_POST['pbb_tags'])
    ]);

    if ($post_id) {

        if (!empty($_POST['pbb_featured'])) {
            set_post_thumbnail($post_id, intval($_POST['pbb_featured']));
        }

        echo '<div class="updated notice"><p>✅ Blog Published Successfully</p></div>';
    }
}
