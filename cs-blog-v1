/*---------------------------------
 Save Blog
----------------------------------*/
function pbb_save() {

    if (!wp_verify_nonce($_POST['pbb_nonce'],'pbb_save')) return;

    $post_id = wp_insert_post([
        'post_title'   => sanitize_text_field($_POST['pbb_title']),
        'post_content' => wp_kses_post($_POST['pbb_content']),
        'post_status'  => 'publish',
        'post_type'    => 'post',
        'post_category'=> [intval($_POST['pbb_category'])],
        'tags_input'   => sanitize_text_field($_POST['pbb_tags']),
        'meta_input'   => [
            '_pbb_quote' => sanitize_textarea_field($_POST['pbb_quote']),
            '_pbb_created_by' => 'yes' // MARK: Yeh post humare plugin se bana hai
        ]
    ]);

    if ($post_id) {

        if (!empty($_POST['pbb_featured'])) {
            set_post_thumbnail($post_id, intval($_POST['pbb_featured']));
        }

        echo '<div class="updated notice"><p>✅ Blog Published Successfully</p></div>';
    }
}

/*---------------------------------
 Check if post is from our plugin
----------------------------------*/
function pbb_is_our_post($post_id = null) {
    if (!$post_id) {
        $post_id = get_the_ID();
    }
    return get_post_meta($post_id, '_pbb_created_by', true) === 'yes';
}

/*---------------------------------
 REMOVE DEFAULT TITLE & FEATURED IMAGE
 (Only for our plugin's posts)
----------------------------------*/

// Remove default title (only our posts)
add_filter('the_title', function($title, $post_id) {
    if (is_single() && get_post_type($post_id) === 'post' && !is_admin() && pbb_is_our_post($post_id)) {
        return '';
    }
    return $title;
}, 10, 2);

// Remove default featured image (only our posts)
add_filter('post_thumbnail_html', function($html, $post_id) {
    if (is_single() && get_post_type($post_id) === 'post' && !is_admin() && pbb_is_our_post($post_id)) {
        return '';
    }
    return $html;
}, 10, 2);

/*---------------------------------
 Frontend Layout (Only our posts)
----------------------------------*/
add_filter('the_content', function($content) {
    // Only for single blog posts from our plugin
    if (!is_single() || get_post_type() !== 'post' || !pbb_is_our_post()) {
        return $content;
    }

    $quote = get_post_meta(get_the_ID(), '_pbb_quote', true);

    ob_start();

    // Featured Image
    if (has_post_thumbnail()) {
        echo '<div class="pbb-featured">';
        the_post_thumbnail('large');
        echo '</div>';
    }

    // Title
    echo '<h1 class="pbb-title">' . get_the_title() . '</h1>';

    // Quote
    if ($quote) {
        echo '<blockquote class="pbb-quote">'
            . esc_html($quote) .
        '</blockquote>';
    }

    // Content
    echo '<div class="pbb-content">' . $content . '</div>';

    return ob_get_clean();
});

