<script>
let frame;

// Featured Image picker
document.getElementById('pbb_featured_btn').onclick = function(){
    if(frame){frame.open();return;}
    frame = wp.media({title:'Select Featured Image',multiple:false});
    frame.on('select',function(){
        let img = frame.state().get('selection').first().toJSON();
        document.getElementById('pbb_featured').value = img.id;
        document.getElementById('pbb_featured_preview').innerHTML =
            '<img src="'+img.url+'" style="max-width:200px;border:1px solid #ccc">';
    });
    frame.open();
};

// Quote Preview
jQuery(function($){
    function renderPreview(){
        let text = $('textarea[name="pbb_quote"]').val();
        if(!text){
            $('#quote-preview').html('');
            return;
        }
        $('#quote-preview').html(
            '<blockquote class="pbb-quote">'+text+'</blockquote>'
        );
    }
    $('textarea[name="pbb_quote"]').on('keyup change', renderPreview);
});
</script>
